+fn trace_mesh(stage: &str, mesh: &Mesh, split: usize) {
+    let mut quality = Vec::new();
+    let mut max_edge: f64 = 0.;
+    let mut area = 0.;
+    for &triangle in &mesh.triangles {
+        let [a, b, c] = triangle.map(|i| mesh.uv[i]);
+        let edges = [distance(a,b),distance(b,c),distance(c,a)];
+        max_edge = max_edge.max(edges.into_iter().fold(0., f64::max));
+        let area2 = cross(a,b,c);
+        area += area2 * 0.5;
+        quality.push(area2 / edges.into_iter().map(|e| e*e).sum::<f64>());
+    }
+    quality.sort_by(f64::total_cmp);
+    eprintln!("{stage}: vertices={} triangles={} split={split} boundary={} area={area:.12} max_edge={max_edge:.12} quality_min={:.9} quality_median={:.9}",mesh.positions.len(),mesh.triangles.len(),mesh.boundary.len(),quality[0],quality[quality.len()/2]);
+}
