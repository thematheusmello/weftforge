+def directory_bytes(directories, *, shallow=(), deadline=None):
+    """Retry only disappearing entries; count temporary files and retain observed partial peaks."""
+    directories, shallow = tuple(map(Path, directories)), tuple(map(Path, shallow))
+    peak = 0
+    for attempt in range(3):
+        total = 0
+
+        def scan(directory, recursive, optional=False):
+            nonlocal total
+            deadline_check(deadline)
+            try:
+                entry = directory.lstat()
+            except FileNotFoundError:
+                if optional:
+                    return
+                raise
+            require(not stat.S_ISLNK(entry.st_mode), f"Symlink volume directory: {directory.name}")
+            require(stat.S_ISDIR(entry.st_mode), f"Not a volume directory: {directory.name}")
+            for path in sorted(directory.iterdir()):
+                deadline_check(deadline)
+                entry = path.lstat()
+                require(not stat.S_ISLNK(entry.st_mode), f"Symlink volume entry: {path.name}")
+                if stat.S_ISDIR(entry.st_mode):
+                    if recursive:
+                        scan(path, True)
+                else:
+                    require(stat.S_ISREG(entry.st_mode), f"Nonregular volume entry: {path.name}")
+                    total += entry.st_size
+
+        try:
+            for directory in directories:
+                scan(directory, True, True)
+            for directory in shallow:
+                scan(directory, False)
+        except FileNotFoundError as error:
+            peak = max(peak, total)
+            deadline_check(deadline)
+            if attempt == 2:
+                raise FileNotFoundError(f"Directory volume unavailable after 3 snapshot attempts: {error}") from error
+        else:
+            deadline_check(deadline)
+            return max(peak, total)
+
