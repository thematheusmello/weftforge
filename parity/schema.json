{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeftForge feature registry",
  "type": "object",
  "required": [
    "schema_version",
    "discovery_complete",
    "features"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "discovery_complete": {
      "type": "boolean"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "title",
          "required_reference_behavior",
          "reference_baseline",
          "source_links",
          "evidence_ids",
          "dependencies",
          "implementation_locations",
          "issues",
          "prs",
          "known_gaps",
          "contradictions",
          "blockers",
          "implementation_status",
          "verification_status",
          "reference_observation_status",
          "freshness",
          "scenarios",
          "comparison_criteria",
          "verification_runs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3}$"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "required_reference_behavior": {
            "type": "string",
            "minLength": 1
          },
          "reference_baseline": {
            "type": "string",
            "minLength": 1
          },
          "source_links": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "implementation_locations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "prs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "known_gaps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "contradictions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "implementation_status": {
            "enum": [
              "planned",
              "in_progress",
              "partial",
              "implemented"
            ]
          },
          "verification_status": {
            "enum": [
              "not_run",
              "passed",
              "failed",
              "blocked",
              "stale"
            ]
          },
          "reference_observation_status": {
            "enum": [
              "unobserved",
              "documentation_only",
              "observed",
              "blocked"
            ]
          },
          "freshness": {
            "enum": [
              "missing",
              "current",
              "stale"
            ]
          },
          "scenarios": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "path",
                "fixture_hashes",
                "initial_conditions",
                "expected_outcomes"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "fixture_hashes": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "initial_conditions": {
                  "type": "string",
                  "minLength": 1
                },
                "expected_outcomes": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "comparison_criteria": {
            "type": "object",
            "required": [
              "units",
              "exact",
              "numerical_tolerances",
              "status"
            ],
            "properties": {
              "units": {
                "type": "string",
                "minLength": 1
              },
              "exact": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "numerical_tolerances": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "metric",
                    "unit",
                    "absolute",
                    "justification"
                  ],
                  "properties": {
                    "metric": {
                      "type": "string",
                      "minLength": 1
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "absolute": {
                      "type": "number",
                      "minimum": 0
                    },
                    "justification": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "status": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "verification_runs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "path",
                "commit",
                "timestamp",
                "platform",
                "artifact_hashes"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "timestamp": {
                  "type": "string",
                  "pattern": "^[0-9T:Z.-]+$"
                },
                "platform": {
                  "type": "string",
                  "minLength": 1
                },
                "artifact_hashes": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "verification_report": {
      "type": "object",
      "required": [
        "id",
        "commit",
        "timestamp",
        "platform",
        "artifact_hashes",
        "reference_baseline",
        "kind",
        "status",
        "feature_ids",
        "complete_contract",
        "reference_executed",
        "source_hashes",
        "source_scope",
        "freshness"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9T:Z.-]+$"
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "artifact_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "reference_baseline": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "implementation_only",
            "reference_comparison"
          ]
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked"
          ]
        },
        "feature_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3}$"
          }
        },
        "complete_contract": {
          "type": "boolean"
        },
        "reference_executed": {
          "type": "boolean"
        },
        "source_hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "source_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "freshness": {
          "enum": [
            "current",
            "stale"
          ]
        },
        "freshness_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "freshness": {
                "const": "stale"
              }
            }
          },
          "then": {
            "required": [
              "freshness_reason"
            ]
          }
        }
      ]
    }
  }
}
